<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Define a regra para Comandos Odoo (O-CMD-...) -->
        <record id="barcode_rule_odoo_command" model="barcode.rule">
            <field name="name">Comandos do Sistema Odoo</field>
            <field name="barcode_nomenclature_id" ref="barcodes.default_barcode_nomenclature"/>
            <field name="sequence">1</field>
            <field name="type">alias</field>
            <field name="pattern">O-CMD-.*</field>
        </record>
    </data>
</odoo>